  "definitions": {
    "ErrorResponse": {
      "type": "object",
      "description": "コントラクト呼び出し時のエラー情報を表現する共通スキーマです。",
      "properties": {
        "message": {
          "type": "string",
          "description": "カスタムエラー名または `revert` / `require` のメッセージ文字列をそのまま格納します。"
        },
        "data": {
          "type": "object",
          "description": "追加情報（任意）です。"
        }
      }
    },
    "ApprovalEvent": {
      "type": "object",
      "description": "Approval",
      "properties": {
        "owner": {
          "type": "string",
          "description": "インデックス付き。所有者のアドレスを指定します。"
        },
        "spender": {
          "type": "string",
          "description": "インデックス付き。トークンの使用を許可するアドレスを指定します。"
        },
        "value": {
          "type": "string",
          "description": "値を指定します。"
        }
      }
    },
    "TransferEvent": {
      "type": "object",
      "description": "Transfer",
      "properties": {
        "from": {
          "type": "string",
          "description": "インデックス付き。送金元のアドレスを指定します。"
        },
        "to": {
          "type": "string",
          "description": "インデックス付き。送金先のアドレスを指定します。"
        },
        "value": {
          "type": "string",
          "description": "値を指定します。"
        }
      }
    }
  }
