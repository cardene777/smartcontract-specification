              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "トークンシンボルを返します。"
                }
              }
            }
          }
        }
      }
    },
    "/totalSupply": {
      "get": {
        "summary": "totalSupply",
        "description": "トークンの総供給量を取得します。\n\nERC20標準関数です。",
        "operationId": "totalSupply",
        "tags": [
          "変数"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "トークンの総供給量を返します。"
                }
              }
            }
          }
        }
      }
    },
    "/transfer": {
      "post": {
        "summary": "transfer",
        "description": "指定されたアドレスにトークンを転送します。\n\nERC20標準関数です。",
        "operationId": "transfer",
        "tags": [
          "書き込み関数"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "送金が成功した場合trueを返します。"
                }
              }
            }
          },
          "500": {
            "description": "この関数で発生しうるエラーの一覧です。<br>・InvalidAddress<br>・AmountZero<br>",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "message": "InvalidAddress",
                "data": {}
              }
            }
          }
        },
        "parameters": [
          {
            "name": "to",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "送金先のアドレスを指定します。"
          },
          {
            "name": "value",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "値を指定します。"
          }
        ]
      }
    },
    "/transferFrom": {
      "post": {
        "summary": "transferFrom",
        "description": "fromからtoへトークンを転送します。事前にallowanceが設定されている必要があります。\n\nERC20標準関数です。",
        "operationId": "transferFrom",
        "tags": [
          "書き込み関数"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "送金が成功した場合trueを返します。"
                }
              }
            }
          },
          "500": {
            "description": "この関数で発生しうるエラーの一覧です。<br>・InvalidAddress<br>・AmountZero<br>",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "message": "InvalidAddress",
                "data": {}
              }
            }
          }
        },
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "送金元のアドレスを指定します。"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "送金先のアドレスを指定します。"
          },
          {
            "name": "value",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "値を指定します。"
          }
        ]
      }
    },
    "/events/Approval": {
      "get": {
        "summary": "Approval",
        "description": "トークンの使用許可が設定された時に発行されるイベントです。所有者、承認された使用者、および許可量が記録されます。",
        "operationId": "event_Approval",
        "tags": [
          "イベント"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "トークンの使用許可が設定された時に発行されるイベントです。所有者、承認された使用者、および許可量が記録されます。",
            "schema": {
              "$ref": "#/definitions/ApprovalEvent"
            }
          }
        }
      }
    },
    "/events/Transfer": {
      "get": {
        "summary": "Transfer",
        "description": "トークンが転送された時に発行されるイベントです。送金元、送金先、および転送量が記録されます。",
        "operationId": "event_Transfer",
        "tags": [
          "イベント"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "トークンが転送された時に発行されるイベントです。送金元、送金先、および転送量が記録されます。",
            "schema": {
              "$ref": "#/definitions/TransferEvent"
            }
          }
        }
      }
    },
    "/errors/ERC20InsufficientAllowance": {
      "get": {
        "summary": "ERC20InsufficientAllowance",
        "description": "リソースが不足している時に返されるエラーです。",
        "operationId": "error_ERC20InsufficientAllowance",
        "tags": [
          "エラー"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "リソースが不足している時に返されるエラーです。",
            "schema": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "example": "ERC20InsufficientAllowance"
                },
                "parameters": {
                  "type": "object",
                  "properties": {
                    "spender": {
                      "type": "string",
                      "description": "トークンの使用を許可するアドレスを指定します。"
                    },
                    "allowance": {
                      "type": "string",
                      "description": "allowanceを指定します。"
                    },
                    "needed": {
                      "type": "string",
                      "description": "neededを指定します。"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
