{
  "swagger": "2.0",
  "info": {
    "title": "ERC20 Solidity Interface",
    "version": "1.0.0",
    "description": "ERC20 コントラクトの Solidity インターフェイスを Swagger 2.0 形式で表現した仕様です。\n\nこのコントラクトは以下のコントラクトを継承しています：\n- Context\n- IERC20\n- IERC20Metadata\n- IERC20Errors"
  },
  "host": "example.com",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "tags": [
    {
      "name": "読み取り関数",
      "description": "ステートを変更せず、コントラクト内の情報を取得する関数。"
    },
    {
      "name": "書き込み関数",
      "description": "ステートを変更する関数。"
    },
    {
      "name": "変数"
    },
    {
      "name": "Mapping"
    },
    {
      "name": "イベント"
    },
    {
      "name": "エラー"
    }
  ],
  "x-tagGroups": [
    {
      "name": "関数",
      "tags": [
        "読み取り関数",
        "書き込み関数"
      ]
    },
    {
      "name": "変数",
      "tags": [
        "変数"
      ]
    },
    {
      "name": "Mapping",
      "tags": [
        "Mapping"
      ]
    },
    {
      "name": "イベント",
      "tags": [
        "イベント"
      ]
    },
    {
      "name": "エラー",
      "tags": [
        "エラー"
      ]
    }
  ],
  "paths": {
    "/allowance": {
      "get": {
        "summary": "allowance",
        "description": "spenderがownerから使用を許可されているトークン量を取得します。\n\nERC20標準関数です。",
        "operationId": "allowance",
        "tags": [
          "Mapping"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "許可された残高を返します。"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "owner",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "所有者のアドレスを指定します。"
          },
          {
            "name": "spender",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "トークンの使用を許可するアドレスを指定します。"
          }
        ]
      }
    },
    "/approve": {
      "post": {
        "summary": "approve",
        "description": "spenderが指定された量のトークンを使用することを承認します。\n\nERC20標準関数です。",
        "operationId": "approve",
        "tags": [
          "書き込み関数"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "承認が成功した場合trueを返します。"
                }
              }
            }
          },
          "500": {
            "description": "この関数で発生しうるエラーの一覧です。<br>・InvalidAddress<br>・AmountZero<br>",
            "schema": {
              "$ref": "#/definitions/ErrorResponse"
            },
            "examples": {
              "application/json": {
                "message": "InvalidAddress",
                "data": {}
              }
            }
          }
        },
        "parameters": [
          {
            "name": "spender",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "トークンの使用を許可するアドレスを指定します。"
          },
          {
            "name": "value",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "値を指定します。"
          }
        ]
      }
    },
    "/balanceOf": {
      "get": {
        "summary": "balanceOf",
        "description": "指定されたアカウントのトークン残高を取得します。\n\nERC20標準関数です。",
        "operationId": "balanceOf",
        "tags": [
          "Mapping"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "アカウントの残高を返します。"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "account",
            "in": "query",
            "required": true,
            "type": "string",
            "description": "対象アカウントのアドレスを指定します。"
          }
        ]
      }
    },
    "/decimals": {
      "get": {
        "summary": "decimals",
        "description": "トークンの小数点以下の桁数を取得します。\n\nERC20標準関数です。通常は18です。",
        "operationId": "decimals",
        "tags": [
          "変数"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "小数点以下の桁数を返します。"
                }
              }
            }
          }
        }
      }
    },
    "/name": {
      "get": {
        "summary": "name",
        "description": "トークンの名前を取得します。\n\nERC20標準関数です。",
        "operationId": "name",
        "tags": [
          "変数"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
            "schema": {
              "type": "object",
              "properties": {
                "result0": {
                  "type": "string",
                  "description": "トークン名を返します。"
                }
              }
            }
          }
        }
      }
    },
    "/symbol": {
      "get": {
        "summary": "symbol",
        "description": "トークンのシンボルを取得します。\n\nERC20標準関数です。",
        "operationId": "symbol",
        "tags": [
          "変数"
        ],
        "produces": [
          "application/json"
        ],
        "responses": {
          "200": {
            "description": "正常終了時のレスポンスです。",
